        "fx": {
          "id": "fx",
          "name": "Chromatic ripple",
          "visible": true,
          "inTick": 0,
          "outTick": 600,
          "opacity": {
            "kind": "constant",
            "value": 1
          },
          "transform": {
            "position": {
              "kind": "constant",
              "value": {
                "x": 0.0,
                "y": 0.0,
                "z": 0
              }
            },
            "anchor": {
              "kind": "constant",
              "value": {
                "x": 0,
                "y": 0,
                "z": 0
              }
            },
            "scale": {
              "kind": "constant",
              "value": {
                "x": 1,
                "y": 1,
                "z": 1
              }
            },
            "rotation": {
              "kind": "constant",
              "value": {
                "x": 0,
                "y": 0,
                "z": 0
              }
            },
            "skew": {
              "kind": "constant",
              "value": {
                "x": 0,
                "y": 0
              }
            }
          },
          "blendMode": "normal",
          "type": "effect",
          "inputId": "art",
          "effect": "custom-sksl",
          "implementation": "uniform shader inputImage;\nuniform float2 center;\nuniform float amplitude;\nuniform float frequency;\nuniform half4 tint;\nuniform float glowMix;\nuniform float invert;   // a boolean parameter arrives as 0.0 or 1.0\n\n// A helper declared outside main. The translator has to keep the prelude and\n// rewrite the eval calls inside it, not just the ones in main.\nhalf3 aberrate(float2 p, float spread) {\n  half r = unpremul(inputImage.eval(p + float2(spread, 0.0))).r;\n  half g = unpremul(inputImage.eval(p)).g;\n  half b = unpremul(inputImage.eval(p - float2(spread, 0.0))).b;\n  return half3(r, g, b);\n}\n\nhalf4 main(float2 p) {\n  // Named `sample` deliberately: legal in SkSL, reserved in GLSL ES 3.00.\n  half4 sample = inputImage.eval(p);\n  float alpha = float(sample.a);\n  float2 delta = p - center;\n  float dist = length(delta);\n  float2 direction = delta / max(dist, 0.0001);\n\n  float wave = sin(dist * frequency - amplitude * 6.2831853);\n\n  // A half-precision matrix. `half` is only a precision hint, so this reduces\n  // to a plain mat2 on the way to GLSL.\n  half angle = half(wave * 0.35);\n  half2x2 swirl = half2x2(cos(angle), -sin(angle), sin(angle), cos(angle));\n  float2 turned = float2(swirl * half2(direction));\n  float2 rippled = p + turned * wave * amplitude * 12.0;\n\n  half3 base = aberrate(rippled, wave * 3.0);\n\n  // A bounded loop accumulating a ring of taps.\n  half3 glow = half3(0.0);\n  for (int i = 0; i < 6; i++) {\n    float angle = float(i) * 1.0471976;\n    glow += unpremul(inputImage.eval(rippled + float2(cos(angle), sin(angle)) * 5.0)).rgb;\n  }\n  glow = glow / 6.0;\n\n  half3 lit = mix(base, glow, saturate(glowMix));\n  half3 toned = mix(lit, tint.rgb, saturate(tint.a) * 0.4);\n  // The boolean arrives as a float, so branch on it the way SkSL requires.\n  half3 finalRgb = invert > 0.5 ? half3(1.0) - toned : toned;\n  return half4(saturate(finalRgb) * alpha, alpha);\n}\n",
